# Variables de entorno del backend. Copiar a `.env` (que está en .gitignore)
# para desarrollo local; en producción van por Secret Manager de Firebase.
# NINGÚN valor real va al repo.

# Store local: bóveda de PII + módulo de paneles.
DSN_LOCAL=postgresql://usuario:clave@127.0.0.1:5432/paneles_local

# Store remoto: embeddings. Instancia Cloud SQL DISTINTA de la local —
# el backend rechaza arrancar si los dos DSN apuntan a la misma base.
DSN_REMOTO=postgresql://usuario:clave@127.0.0.1:5432/paneles_remoto

# Embeddings. `deterministico` no usa red: sirve para pruebas y emulador.
EMBEDDINGS_PROVEEDOR=voyage
EMBEDDINGS_MODELO=voyage-3.5
EMBEDDINGS_DIMS=1024
EMBEDDINGS_API_KEY=
