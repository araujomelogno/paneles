# Variables de entorno del RUNTIME de la función.
#
# Copiá este archivo a `functions/.env` (o `.env.gestion-paneles` para que
# aplique solo a ese proyecto) y ajustá lo que haga falta. `firebase deploy`
# lo lee y lo convierte en variables de entorno de la función desplegada.
#
# OJO con la diferencia, que es la que más confunde:
#
#   * Lo de acá abajo son variables de RUNTIME: las lee el código cuando
#     atiende una request. Van en `.env`.
#   * `VPC_CONNECTOR` es una variable de DEPLOY: `functions/main.py` la lee al
#     construir el manifiesto, antes de subir nada. Va como
#     `export VPC_CONNECTOR=paneles-conn` en la shell desde la que se
#     despliega, y NO acá.
#
# Los SECRETOS no van acá ni en ningún archivo del repo: van a Secret Manager
# con `firebase functions:secrets:set` (ver los manuales de despliegue), y
# además tienen que estar declarados en la lista `SECRETOS` de `main.py`: si
# no, `firebase deploy` no los monta y el runtime los ve vacíos aunque estén
# guardados. Son: DSN_BOVEDA, DSN_SEMANTICA, EMBEDDINGS_API_KEY,
# RERANKER_API_KEY, CLAUDE_API_KEY, VERIFICACION_SAL, DESAFIO_SECRETO,
# WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_WABA_ID, PORTAL_URL,
# TAREAS_URL, TAREAS_CUENTA y SMTP_PASSWORD.
#
# OJO con los nombres: `firebase deploy` rechaza toda variable —de este
# archivo o de Secret Manager— que empiece con FIREBASE_, X_GOOGLE_, EXT_ o
# KIT_ («starts with a reserved prefix»). `functions/tests/test_main.py` lo
# comprueba.
#
# `.env` y `.env.*` están en .gitignore; este `.env.ejemplo` es la excepción.

# ── Embeddings (Fase 1) ──────────────────────────────────────────────
# voyage | bolsa (sin red, para pruebas)
EMBEDDINGS_PROVEEDOR=voyage
EMBEDDINGS_MODELO=voyage-3.5
# 512 y no las 1024 del default de Voyage: la mitad de vector es la
# mitad de instancia, y `voyage-3.5` está entrenado con Matryoshka,
# así que truncar no es cortar al azar. Tiene que coincidir con la
# dimensión de `respuesta.embedding` en el store semántico.
EMBEDDINGS_DIMS=512

# ── Reranking (Fase 2, R2.8) ─────────────────────────────────────────
# voyage | lexico (sin red) | ninguno (apagado: la consulta degrada avisando)
RERANKER_PROVEEDOR=voyage
RERANKER_MODELO=rerank-2.5

# ── Verificación (Fase 2, R2.9) ──────────────────────────────────────
# claude | lexico (sin red) | ninguno (apagada: la consulta degrada avisando)
VERIFICACION_PROVEEDOR=claude
CLAUDE_MODELO=claude-sonnet-5
# Verificación por lotes (SPEC_verificacion_por_lotes). Los defaults están
# pensados para que una consulta de COLOQUIO (timeout de 90 s) entre entera:
#   VERIFICACION_LOTE             evidencias por llamada a Claude (25)
#   VERIFICACION_CONCURRENCIA     llamadas en paralelo (4); subirlo choca con
#                                 el límite de tasa de la API
#   VERIFICACION_PRESUPUESTO_S    segundos para toda la verificación de una
#                                 consulta (60); lo que no entra queda
#                                 «sin verificar»
#   VERIFICACION_PROFUNDIDAD_MAX  cuántas veces se puede partir un lote
#                                 truncado (5: 25 → 1)
VERIFICACION_LOTE=25
VERIFICACION_CONCURRENCIA=4
VERIFICACION_PRESUPUESTO_S=60
VERIFICACION_PROFUNDIDAD_MAX=5
# R-VER.10 — modo de depuración: guarda en el store semántico, por 7 días,
# el cuerpo exacto de cada llamada a Claude y su respuesta. APAGADO por
# defecto. Encenderlo para diagnosticar y apagarlo después: cada consulta
# deja varios cientos de kB.
# VERIFICACION_DEPURACION=1
# VERIFICACION_DEPURACION_DIAS=7

# ── Portal del panelista (R6.1.a · PEDIDO R1) ────────────────────────
# La *web API key* del proyecto, con la que el backend comprueba las
# contraseñas del portal contra Identity Toolkit. NO es un secreto: es la
# misma `apiKey` que está en web/public/index.html y portal.html, la que recibe cada
# navegador (Consola de Firebase → Configuración del proyecto → General →
# «Clave de API web»). Va acá, con su valor literal, y no en Secret Manager.
#
# Se llamaba FIREBASE_WEB_API_KEY: ese nombre no se puede cargar (prefijo
# reservado) y por eso en producción quedó el placeholder. Sin ella, o con
# un valor que no tiene la forma «AIza» + 35 caracteres, el portal informa
# un problema técnico y nadie entra.
WEB_API_KEY=

# ── Padrón de usuarios de la app (Fase 2, R2.12) ─────────────────────
# Vacío = Firebase Auth + Firestore. `memoria` solo para desarrollo local.
# PADRON_USUARIOS=memoria

# ── Contacto (Fase 4, R4.3) ──────────────────────────────────────────
# Los dos son nombres de proveedor, no credenciales: sus claves
# (VERIFICACION_SAL y DESAFIO_SECRETO) van a Secret Manager.
# workspace (producción) | ninguno | log
#   workspace  SMTP de Google Workspace; la contraseña de aplicación va a
#              Secret Manager como SMTP_PASSWORD (R-MAIL)
#   ninguno    no envía: el portal y la landing informan un error de
#              configuración. NO devuelve el código ni el enlace.
#   log        no envía: deja el código/enlace en el log del servidor
VERIFICACION_ENVIO_PROVEEDOR=workspace
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS · 465 = SSL
SMTP_PORT=587
SMTP_USUARIO=notificaciones@equipos.com.uy
SMTP_REMITENTE=Equipos Consultores <notificaciones@equipos.com.uy>
# Una casilla que alguien lea: a dónde van las respuestas de los panelistas.
SMTP_REPLY_TO=
# Por intento y para el envío entero, en segundos (8 y 15).
# SMTP_TIEMPO_S=8
# SMTP_PRESUPUESTO_S=15
#
# R-MAIL.2 — SOLO en una máquina de desarrollo: sin proveedor, devuelve el
# código y el enlace en la respuesta. NUNCA en el .env que se despliega (y
# aunque estuviera, en Cloud Run se ignora).
# ENVIO_MODO_DESARROLLO=1
# ninguno (default: no bloquea envíos automatizados) | turnstile | recaptcha
DESAFIO_PROVEEDOR=ninguno
