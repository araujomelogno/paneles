# Variables de entorno del RUNTIME de la función.
#
# Copiá este archivo a `functions/.env` (o `.env.gestion-paneles` para que
# aplique solo a ese proyecto) y ajustá lo que haga falta. `firebase deploy`
# lo lee y lo convierte en variables de entorno de la función desplegada.
#
# OJO con la diferencia, que es la que más confunde:
#
#   * Lo de acá abajo son variables de RUNTIME: las lee el código cuando
#     atiende una request. Van en `.env`.
#   * `VPC_CONNECTOR` es una variable de DEPLOY: `functions/main.py` la lee al
#     construir el manifiesto, antes de subir nada. Va como
#     `export VPC_CONNECTOR=paneles-conn` en la shell desde la que se
#     despliega, y NO acá.
#
# Los SECRETOS no van acá ni en ningún archivo del repo: van a Secret Manager
# con `firebase functions:secrets:set` (ver los manuales de despliegue), y
# además tienen que estar declarados en la lista `SECRETOS` de `main.py`: si
# no, `firebase deploy` no los monta y el runtime los ve vacíos aunque estén
# guardados. Son: DSN_BOVEDA, DSN_SEMANTICA, EMBEDDINGS_API_KEY,
# RERANKER_API_KEY, CLAUDE_API_KEY, VERIFICACION_SAL, DESAFIO_SECRETO,
# WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID y WHATSAPP_WABA_ID.
#
# `.env` y `.env.*` están en .gitignore; este `.env.ejemplo` es la excepción.

# ── Embeddings (Fase 1) ──────────────────────────────────────────────
# voyage | bolsa (sin red, para pruebas)
EMBEDDINGS_PROVEEDOR=voyage
EMBEDDINGS_MODELO=voyage-3.5
EMBEDDINGS_DIMS=1024

# ── Reranking (Fase 2, R2.8) ─────────────────────────────────────────
# voyage | lexico (sin red) | ninguno (apagado: la consulta degrada avisando)
RERANKER_PROVEEDOR=voyage
RERANKER_MODELO=rerank-2.5

# ── Verificación (Fase 2, R2.9) ──────────────────────────────────────
# claude | lexico (sin red) | ninguno (apagada: la consulta degrada avisando)
VERIFICACION_PROVEEDOR=claude
CLAUDE_MODELO=claude-sonnet-5

# ── Padrón de usuarios de la app (Fase 2, R2.12) ─────────────────────
# Vacío = Firebase Auth + Firestore. `memoria` solo para desarrollo local.
# PADRON_USUARIOS=memoria

# ── Contacto (Fase 4, R4.3) ──────────────────────────────────────────
# Los dos son nombres de proveedor, no credenciales: sus claves
# (VERIFICACION_SAL y DESAFIO_SECRETO) van a Secret Manager.
# ninguno (default: la landing no verifica de verdad) | log
VERIFICACION_ENVIO_PROVEEDOR=ninguno
# ninguno (default: no bloquea envíos automatizados) | turnstile | recaptcha
DESAFIO_PROVEEDOR=ninguno
